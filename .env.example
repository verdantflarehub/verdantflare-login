# Go backend
VF_ENV=development
VF_LISTEN_ADDR=:8088
VF_HUB_URL=https://hub.verdantflarehub.com
VF_PUBLIC_LOGIN_URL=http://localhost:4174
VF_SESSION_COOKIE_NAME=vf_session
VF_SESSION_COOKIE_SECURE=false
VF_SESSION_TTL=12h
VF_VERIFICATION_TTL=10m
VF_PASSWORD_RESET_TTL=30m
VF_DATABASE_URL=
VF_DATABASE_MAX_OPEN=10
VF_DATABASE_MAX_IDLE=5
VF_MAIL_PROVIDER=log
VF_MAIL_FROM=
VF_RESEND_API_KEY=

# Generate a stable, random value before production deployment.
VF_TOKEN_PEPPER=

# Local development only. When enabled, the verification API returns debugCode.
VF_EXPOSE_DEBUG_CODES=true

# Vue frontend
VITE_USE_MOCK=false
VITE_AUTH_API_BASE=/api/auth
VITE_HUB_URL=https://hub.verdantflarehub.com
